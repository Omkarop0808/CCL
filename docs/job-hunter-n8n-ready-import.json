      "position": [
        760,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst roles = Array.isArray(input.targetRoles) && input.targetRoles.length ? input.targetRoles : ['Software Engineer'];\nconst filters = input.filters || {};\nconst location = String(filters.location || 'India');\nconst keyword = String(filters.keyword || roles[0] || 'Engineer');\nconst now = new Date();\n\nconst jobs = roles.slice(0, 5).map((role, i) => ({\n  externalId: `${input.runId}-demo-${i + 1}`,\n  title: `${role}`,\n  company: ['Google', 'Microsoft', 'Amazon', 'Atlassian', 'Adobe'][i % 5],\n  location,\n  url: `https://example.com/jobs/${encodeURIComponent(role.toLowerCase().replace(/\\s+/g, '-'))}-${i + 1}`,\n  description: `Auto-generated sample listing for ${role}. Keyword focus: ${keyword}.`,\n  postedAt: new Date(now.getTime() - i * 86400000).toISOString(),\n  source: 'linkedin',\n  easyApply: Boolean(filters.easyApply),\n  skills: ['JavaScript', 'React', 'Node.js'],\n  improvements: ['Tailor resume to JD', 'Highlight quantified impact'],\n  score: 75 + i * 4,\n  raw: { generatedBy: 'n8n-demo' }\n}));\n\nreturn [{ json: { ...input, jobs } }];"
      },
      "id": "4",
      "name": "Build Jobs Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        260
      ]
    },
