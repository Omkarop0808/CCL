        "jsonBody": "={{ ({ eventType: 'run_completed', runId: $json.runId, userId: $json.userId, jobs: [], meta: { source: 'n8n', stage: 'run_completed', generatedCount: Array.isArray($json.jobs) ? $json.jobs.length : 0 } }) }}",
        "options": {}
      },
