        "jsonBody": "={{ ({ eventType: 'jobs_batch', runId: $json.runId, userId: $json.userId, jobs: $json.jobs || [], meta: { source: 'n8n', stage: 'jobs_batch' } }) }}",
        "options": {}
      },
